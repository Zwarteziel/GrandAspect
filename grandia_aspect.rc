// Version information for d3d11.dll (Grand Aspect).
// Compiled by build.bat with rc.exe and linked into the DLL, so that
// Windows (file properties > Details) and virus scanners can see what it is.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,3,1,0
 PRODUCTVERSION 1,3,1,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Grand Aspect (Zwarteziel)"
            VALUE "FileDescription",  "Grand Aspect - 60 fps and display mode mod for GRANDIA HD Remaster (Direct3D 11 proxy)"
            VALUE "FileVersion",      "1.3.1.0"
            VALUE "InternalName",     "grand_aspect"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Zwarteziel. GPL-3.0-or-later (except the CRT shader). GRANDIA is the property of its respective owners."
            VALUE "OriginalFilename", "d3d11.dll"
            VALUE "ProductName",      "Grand Aspect"
            VALUE "ProductVersion",   "1.3.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
